#!/bin/sh
# Snapdrop start-stop-status script (DSM 6.2 / package run-as user)
#
# Called by DSM as:  start-stop-status {start|stop|status}
# The service itself is started as the package user defined in conf/privilege.

PKG_NAME="${SYNOPKG_PKGNAME:-snapdrop}"
PKG_DEST="${SYNOPKG_PKGDEST:-/var/packages/${PKG_NAME}/target}"
# DSM 6 does not define SYNOPKG_PKGVAR (that is DSM 7), so derive it from the target dir.
PKG_VAR="${SYNOPKG_PKGVAR:-${PKG_DEST}/var}"
LOG_FILE="${PKG_VAR}/${PKG_NAME}.log"
PID_FILE="${PKG_VAR}/${PKG_NAME}.pid"
# Port the web interface listens on. Must match adminport in INFO.
SERVICE_PORT="${SNAP_PORT:-3000}"

mkdir -p "${PKG_VAR}" 2>/dev/null

# Locate a usable Node.js runtime. The package depends on Synology's "Node.js v12"
# (see install_dep_packages in INFO); the other paths are fallbacks.
find_node() {
    for candidate in \
        /var/packages/Node.js_v20/target/bin/node \
        /var/packages/Node.js_v18/target/bin/node \
        /var/packages/Node.js_v16/target/bin/node \
        /var/packages/Node.js_v12/target/bin/node \
        /var/packages/Node.js_v8/target/bin/node \
        /var/packages/Node.js_v12/target/usr/local/bin/node \
        /usr/local/bin/node \
        /usr/bin/node \
        /opt/bin/node; do
        if [ -x "${candidate}" ]; then
            echo "${candidate}"
            return 0
        fi
    done
    command -v node 2>/dev/null
}

NODE_BIN="$(find_node)"

is_running() {
    [ -f "${PID_FILE}" ] || return 1
    _pid="$(cat "${PID_FILE}" 2>/dev/null)"
    [ -n "${_pid}" ] || return 1
    kill -0 "${_pid}" 2>/dev/null
}

do_start() {
    if is_running; then
        echo "${PKG_NAME} is already running"
        return 0
    fi
    if [ -z "${NODE_BIN}" ]; then
        echo "ERROR: Node.js runtime not found. Install 'Node.js v12' from Package Center." >&2
        return 1
    fi
    echo "$(date) Starting ${PKG_NAME} (node=${NODE_BIN}, port=${SERVICE_PORT})" >> "${LOG_FILE}"
    cd "${PKG_DEST}" || return 1
    PORT="${SERVICE_PORT}" "${NODE_BIN}" "${PKG_DEST}/index.js" >> "${LOG_FILE}" 2>&1 &
    echo $! > "${PID_FILE}"
    sleep 1
    if is_running; then
        echo "${PKG_NAME} started (pid $(cat "${PID_FILE}"))"
        return 0
    fi
    echo "ERROR: ${PKG_NAME} failed to start, see ${LOG_FILE}" >&2
    return 1
}

do_stop() {
    if ! is_running; then
        rm -f "${PID_FILE}" 2>/dev/null
        echo "${PKG_NAME} is not running"
        return 0
    fi
    _pid="$(cat "${PID_FILE}")"
    echo "$(date) Stopping ${PKG_NAME} (pid ${_pid})" >> "${LOG_FILE}"
    kill -TERM "${_pid}" 2>/dev/null
    _i=0
    while [ "${_i}" -lt 20 ]; do
        kill -0 "${_pid}" 2>/dev/null || break
        _i=$((_i + 1))
        sleep 1
    done
    if kill -0 "${_pid}" 2>/dev/null; then
        kill -KILL "${_pid}" 2>/dev/null
    fi
    rm -f "${PID_FILE}" 2>/dev/null
    echo "${PKG_NAME} stopped"
    return 0
}

case "$1" in
    start)
        do_start
        exit $?
        ;;
    stop)
        do_stop
        exit $?
        ;;
    status)
        if is_running; then
            echo "${PKG_NAME} is running"
            exit 0
        else
            echo "${PKG_NAME} is not running"
            exit 3
        fi
        ;;
    log)
        [ -f "${LOG_FILE}" ] && tail -n 100 "${LOG_FILE}"
        exit 0
        ;;
    *)
        echo "Usage: $0 {start|stop|status|log}" >&2
        exit 1
        ;;
esac
